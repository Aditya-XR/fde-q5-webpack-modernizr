{
  "name": "fde-q5-webpack-modernizr",
  "version": "1.0.0",
  "private": true,
  "description": "Monthly Expense Tracker - assignment Q5: Webpack bundling, code splitting and production optimisation, with Modernizr detecting <input type=\"month\"> and a lazy-loaded fallback.",
  "scripts": {
    "start": "webpack serve --mode development",
    "build": "webpack --mode production",
    "analyze": "webpack --mode production --env analyze",
    "preview": "http-server dist -p 5000 -c-1",
    "modernizr": "modernizr -c modernizr-config.json -d modernizr-build.js"
  },
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=22.15"
  },
  "dependencies": {
    "flatpickr": "^4.6.13"
  },
  "devDependencies": {
    "css-loader": "^7.1.5",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "html-webpack-plugin": "^5.6.8",
    "http-server": "^14.1.1",
    "mini-css-extract-plugin": "^2.10.2",
    "modernizr": "^3.13.1",
    "style-loader": "^4.0.0",
    "webpack": "^5.111.1",
    "webpack-bundle-analyzer": "^5.4.0",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  }
}
